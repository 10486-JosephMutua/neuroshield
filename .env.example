# Nebius Token Factory (OpenAI-compatible API)
NEBIUS_API_KEY=your_token_factory_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model IDs. Check them with: python scripts/verify_token_factory.py
NEUROSHIELD_MODEL_ANALYST=nvidia/Nemotron-3-Ultra-550b-a55b
NEUROSHIELD_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Local services. Use 0.0.0.0 for NEUROSHIELD_FLASK_HOST when deploying.
NEUROSHIELD_MCP_HOST=127.0.0.1
NEUROSHIELD_BIOMARKER_PORT=8101
NEUROSHIELD_MEMORY_PORT=8102
NEUROSHIELD_REPORT_PORT=8103
NEUROSHIELD_EVIDENCE_PORT=8104
NEUROSHIELD_FLASK_HOST=127.0.0.1
NEUROSHIELD_FLASK_PORT=5000

# Storage and logging
NEUROSHIELD_DB_PATH=data/neuroshield.db
NEUROSHIELD_LOG_DIR=logs
NEUROSHIELD_LOG_LEVEL=INFO

# Daily check-in: the only feature that sends conversational text to a cloud model.
# Set to false to disable it entirely.
NEUROSHIELD_CHECKIN_CONSENT=true
NEUROSHIELD_MAX_VERIFY_ATTEMPTS=2

# Reuse an identical, still-valid analysis instead of calling the models again.
NEUROSHIELD_ANALYSIS_CACHE=true
# Maximum number of analyses calling the models at the same time.
NEUROSHIELD_MAX_CONCURRENT_ANALYSES=1  # safer for 512 MB RAM

# Optional: run the check-in on a local model so chat text never leaves the machine.
# Any OpenAI-compatible server works, for example Ollama at http://localhost:11434/v1.
NEUROSHIELD_CHECKIN_BASE_URL=
NEUROSHIELD_CHECKIN_MODEL=nemotron-3-nano:30b
NEUROSHIELD_CHECKIN_API_KEY=local

# Optional: background scan that notifies when a signal changes.
NEUROSHIELD_WATCHER=false
NEUROSHIELD_WATCHER_INTERVAL_MINUTES=60
# If true, a detected change also starts the full analysis automatically.
NEUROSHIELD_WATCHER_AUTO_ANALYZE=false

# Optional: background reading links in the clinician report (Tavily search).
TAVILY_API_KEY=
